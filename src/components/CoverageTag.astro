---
/** "Covered by AHCIP" or "Not covered by AHCIP". Always words plus an icon, never colour alone. */
import Icon from './Icon.astro';
import { coverageLabel, type Coverage } from '../data/services';

interface Props {
  coverage: Coverage;
}

const { coverage } = Astro.props;
---

<p class="coverage" data-coverage={coverage}>
  <Icon name={coverage === 'ahcip' ? 'check' : 'info'} />
  {coverageLabel[coverage]}
</p>

<style>
  .coverage {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .coverage[data-coverage='ahcip'] {
    background: var(--white);
    color: var(--clinic-teal);
  }

  .coverage[data-coverage='uninsured'] {
    color: var(--text);
  }
</style>
